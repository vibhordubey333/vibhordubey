---
import siteConfig from "../config/site";
import { absoluteUrl } from "../lib/url";

interface JsonLdObject {
  [key: string]: unknown;
}

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  jsonLd?: JsonLdObject | JsonLdObject[];
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonicalPath = "/",
  image = siteConfig.defaultOgImage,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd = [],
  noindex = false
} = Astro.props;

const siteName = siteConfig.title;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalUrl = absoluteUrl(canonicalPath, Astro.site ?? siteConfig.origin);
const resolvedImage = absoluteUrl(image, Astro.site ?? siteConfig.origin);
const rssUrl = absoluteUrl(siteConfig.rssPath, Astro.site ?? siteConfig.origin);
const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const lightThemeColor = siteConfig.themeColors.light;
const gaId = siteConfig.googleAnalyticsId;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="light dark" />
<meta data-theme-color name="theme-color" content={lightThemeColor} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<link rel="icon" href={absoluteUrl("/favicon.svg", Astro.site ?? siteConfig.origin)} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href={rssUrl} />

<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:locale" content={siteConfig.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage} />

{type === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === "article" && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === "article" &&
  tags.map((tag) => <meta property="article:tag" content={tag} />)}

{
  jsonLdBlocks.map((entry) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))
}

{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
