---
import "@fontsource-variable/manrope";
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono";
import "../styles/global.css";

import Head from "../components/Head.astro";
import siteConfig from "../config/site";
import { withBase } from "../lib/url";

interface JsonLdObject {
  [key: string]: unknown;
}

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  jsonLd?: JsonLdObject | JsonLdObject[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = "/",
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd = [],
  noindex = false
} = Astro.props;

const currentPath = Astro.url.pathname;
const homeHref = withBase("/");
const year = new Date().getFullYear();

function isCurrent(href: string) {
  const target = withBase(href);

  if (href === "/") {
    return currentPath === homeHref;
  }

  return currentPath.startsWith(target);
}
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <Head
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={homeHref}>
          <span class="brand__mark" aria-hidden="true">
            <span>{`{`}</span>
            <span>{`}`}</span>
          </span>
          <span class="brand__text">
            <strong>{siteConfig.author.name}</strong>
            <span>{siteConfig.title}</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          {
            siteConfig.navigation.map((item) => (
              <a class:list={[isCurrent(item.href) && "is-active"]} href={withBase(item.href)}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main id="content" class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          <strong>{siteConfig.author.name}</strong> publishes here first, then syndicates elsewhere
          with canonical links intact.
        </p>
        <ul class="social-links" aria-label="Footer links">
          {
            siteConfig.socialLinks.map((link) => (
              <li>
                <a href={withBase(link.href)}>{link.label}</a>
              </li>
            ))
          }
        </ul>
        <p class="site-footer__note">© {year}. Built with Astro, Markdown, and GitHub Pages.</p>
      </footer>
    </div>
  </body>
</html>
