---
import AuthorBio from "../components/AuthorBio.astro";
import Prose from "../components/Prose.astro";
import siteConfig from "../config/site";
import { absoluteUrl } from "../lib/url";
import BaseLayout from "../layouts/BaseLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.author.name,
  jobTitle: siteConfig.author.role,
  description: siteConfig.author.bio,
  url: absoluteUrl("/about/", Astro.site ?? siteConfig.origin),
  sameAs: [siteConfig.author.url]
};
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.author.name}, the voice behind ${siteConfig.title}.`}
  canonicalPath="/about/"
  jsonLd={jsonLd}
>
  <section class="page-intro">
    <p class="section-heading__eyebrow">About</p>
    <h1>The site exists to keep the original close at hand.</h1>
    <p>
      This is a calm home for technical writing: polished enough to feel deliberate, small enough
      to stay maintainable.
    </p>
  </section>

  <Prose>
    <p>
      I am a Senior Backend Engineer building distributed systems that handle high volume load and
      stay up. Over 8+ years, I have worked across event-driven pipelines, high-throughput APIs,
      and cloud-native infrastructure, primarily in Go and Java Spring Boot.
    </p>
    <p>
      Most of my work lives at the intersection of distributed systems and observability:
      designing for failure, reducing MTTD, and making production less surprising. Most of what
      appears here starts from working notes, turns into a practical draft, and eventually becomes
      something worth syndicating.
    </p>
  </Prose>

  <AuthorBio />
</BaseLayout>
