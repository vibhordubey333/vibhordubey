---
import AuthorBio from "../components/AuthorBio.astro";
import PostCard from "../components/PostCard.astro";
import siteConfig from "../config/site";
import { getPublishedPosts, getTagCollection } from "../lib/posts";
import { absoluteUrl, withBase } from "../lib/url";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 3);
const tagHighlights = getTagCollection(posts).slice(0, 6);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.title,
    description: siteConfig.description,
    url: absoluteUrl("/", Astro.site ?? siteConfig.origin)
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: siteConfig.author.name,
    jobTitle: siteConfig.author.role,
    description: siteConfig.author.bio,
    url: siteConfig.author.url
  }
];
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <p class="hero__eyebrow">POSSE technical writing, without platform lock-in</p>
    <h1>Publish thoughtfully. Keep the original on your own site.</h1>
    <p class="hero__lede">
      Tutorials, frontend notes, essays, and quiet engineering lessons collected in one place,
      then syndicated outward with clear canonical ownership.
    </p>

    <div class="hero__actions">
      <a class="button" href={withBase("/blog/")}>Read the blog</a>
      <a class="button button--secondary" href={withBase("/about/")}>About the author</a>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="section-heading__eyebrow">Recent writing</p>
      <h2>Fresh posts from the notebook</h2>
    </div>

    <div class="post-grid">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="section-block section-block--split">
    <div class="section-heading">
      <p class="section-heading__eyebrow">Topics</p>
      <h2>Organized for reading, not for clutter</h2>
      <p>
        Tags stay lightweight so the archive remains easy to scan and quick to maintain.
      </p>
    </div>

    <div class="pill-grid">
      {
        tagHighlights.map((tag) => (
          <a class="tag-panel" href={withBase(`/tags/${tag.slug}/`)}>
            <strong>{tag.label}</strong>
            <span>{tag.count} post{tag.count === 1 ? "" : "s"}</span>
          </a>
        ))
      }
    </div>
  </section>

  <AuthorBio />
</BaseLayout>
