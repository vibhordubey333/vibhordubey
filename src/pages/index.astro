---
import siteConfig from "../config/site";
import { getPublishedPosts, formatDate } from "../lib/posts";
import { absoluteUrl, withBase } from "../lib/url";
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthorBio from "../components/AuthorBio.astro";

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 10);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.title,
    description: siteConfig.description,
    url: absoluteUrl("/", Astro.site ?? siteConfig.origin)
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: siteConfig.author.name,
    jobTitle: siteConfig.author.role,
    description: siteConfig.author.bio,
    url: siteConfig.author.url
  }
];
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <AuthorBio />

  <section class="section-block">
    <div class="section-heading">
      <h2>Recent blog posts <span style="font-size: 1.2rem; margin: 0 0.5rem; color: var(--muted);">&bull;</span> <a href={withBase("/blog/")} style="font-size: 1.2rem; font-family: var(--font-sans); font-weight: normal;">Full archive &rarr;</a></h2>
      <p>Things I have written recently.</p>
    </div>

    <ul style="list-style: none; padding-left: 0; margin-top: 1rem; display: flex; flex-direction: column; gap: 0.8rem;">
      {recentPosts.map((post) => (
        <li style="font-size: 1.1rem; color: var(--text); display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap;">
          <span style="font-family: var(--font-mono); color: var(--accent); font-weight: bold;">
            &gt;_
          </span>
          <a href={withBase(`/blog/${post.id}/`)} style="text-decoration: none; font-weight: 500;">
            {post.data.title}
          </a>
          <span style="font-family: var(--font-mono); color: var(--muted); font-size: 0.9rem; margin-left: 0.5rem;">
            {formatDate(post.data.pubDate)}
          </span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
