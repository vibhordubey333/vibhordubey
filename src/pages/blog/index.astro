---
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Technical blog posts published on the canonical site first."
  canonicalPath="/blog/"
>
  <div class="post-grid">
    {posts.slice(0, 5).map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
